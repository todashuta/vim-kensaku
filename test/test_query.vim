vim9script
# Compares kensaku#query() results against the expected values generated by
# jsmigemo.  Run from the repository root via test/run.sh.
runtime! plugin/*.vim

var out: list<string> = []
for q in readfile('test/queries.txt')
  out->add(q .. "\t" .. kensaku#query(q))
endfor
out->add("\t" .. kensaku#query(''))
out->add('kaguyakaguyakaguya' .. "\t" .. kensaku#query('kaguyakaguyakaguya'))
out->add('tsukuyomikensaku' .. "\t" .. kensaku#query('tsukuyomikensaku'))
writefile(out, 'test/actual/query.tsv')
qa!
